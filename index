<script>
const input = document.getElementById('search');
const body = document.getElementById('rows');
const count = document.getElementById('count');
const allRows = [...body.rows];
function filterRows() {
  const q = input.value.toLocaleLowerCase('de').trim();
  let visible = 0;
  for (const row of allRows) {
    const match = !q || row.innerText.toLocaleLowerCase('de').includes(q);
    row.hidden = !match;
    if (match) visible++;
  }
  count.textContent = `${visible.toLocaleString('de')} von ${allRows.length.toLocaleString('de')} Alben`;
}
input.addEventListener('input', filterRows);
document.getElementById('reset').addEventListener('click', () => {
  input.value = '';
  filterRows();
  input.focus();
});
filterRows();
</script>
